[MASTER]
init-hook='import sys; sys.path.append("src")'
ignore=conftest.py, models.py
ignore-patterns=test_.*\.py

[MESSAGES CONTROL]
disable= too-few-public-methods, no-self-argument
disable=duplicate-code

[BASIC]
no-docstring-rgx=^(test|_)

[TYPECHECK]
ignored-modules=passlib,jose
good-names=SessionLocal
